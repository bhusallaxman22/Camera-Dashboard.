# Paste into the Dockge stack's .env panel. Only POSTGRES_PASSWORD is required.

# openssl rand -hex 24   (letters/digits only: it is embedded in a URL)
POSTGRES_PASSWORD=

# "latest" follows master; pin a build with e.g. IMAGE_TAG=sha-9ded116
IMAGE_TAG=latest

PHOTO_HOST_ROOT=/mnt/mainpool/photos/z6iii
APP_DATA_DIR=/mnt/mainpool/apps/z6iii-ai/data
POSTGRES_DATA_DIR=/mnt/mainpool/apps/z6iii-ai/postgres
REDIS_DATA_DIR=/mnt/mainpool/apps/z6iii-ai/redis

TZ=America/Chicago
FRONTEND_PORT=8765
BACKEND_PORT=8766
SMB_PHOTO_ROOT=\\truenas\Z6III_Photos

# Optional
# IMMICH_ENABLED=true
# IMMICH_URL=http://192.168.0.142:2283
# IMMICH_PUBLIC_URL=http://192.168.0.142:2283
# IMMICH_API_KEY=
# AI_PROVIDER=ollama
# OLLAMA_URL=http://192.168.0.142:11434
# WORKER_PROCESSES=2
# API_TOKEN=
