# =============================================================================
# Z6III AI Studio — environment configuration
# Copy to `.env` (same folder as compose.yaml) and edit. Never commit `.env`.
# =============================================================================

# ---- Host paths (TrueNAS) ---------------------------------------------------
# Camera library on the NAS. Mounted READ-ONLY into the containers at /photos.
PHOTO_HOST_ROOT=/mnt/mainpool/photos/z6iii
# Generated data (thumbnails, previews, postgres, redis). Must be writable.
APP_DATA_DIR=/mnt/mainpool/configs/z6iii-ai/data

# UID/GID the app containers run as. Must be able to READ the photo dataset
# and WRITE APP_DATA_DIR. 568 is the TrueNAS "apps" user.
PUID=568
PGID=568

# Published ports (LAN). Postgres and Redis are never published.
FRONTEND_PORT=8765
BACKEND_PORT=8766

TZ=America/Chicago

# ---- Database -----------------------------------------------------------------
POSTGRES_DB=z6iii
POSTGRES_USER=z6iii
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- Paths inside the containers (defaults match compose.yaml) ---------------
PHOTO_ROOT=/photos
JPEG_ROOT=/photos/immich-jpeg
RAW_ROOT=/photos/raw
VIDEO_ROOT=/photos/video
# Where the sorter puts formats it doesn't recognise (Nikon HEIF .HIF). Empty = don't watch.
UNSORTED_ROOT=/photos/unsorted
DATA_ROOT=/data
THUMBNAIL_ROOT=/data/thumbnails
PREVIEW_ROOT=/data/previews
CACHE_ROOT=/data/cache

# How paths are displayed to you (for editors / SMB). /photos is replaced by:
NAS_PHOTO_ROOT=/mnt/mainpool/photos/z6iii
# Optional SMB share for "copy SMB path" (leave blank to hide). Accepts
# \\truenas\photos\z6iii, truenas\photos\z6iii, //truenas/photos or smb://truenas/photos
SMB_PHOTO_ROOT=

# ---- Ingest / watcher ----------------------------------------------------------
WATCH_ENABLED=true
# auto | inotify | polling   (use polling if events are missed on your mount)
WATCH_MODE=auto
WATCH_POLL_INTERVAL_SECONDS=2
# A file must keep the same size+mtime this long before it is processed.
FILE_STABLE_SECONDS=3
SCAN_ON_STARTUP=true
# Safety-net full reconcile scan (0 disables).
RECONCILE_INTERVAL_MINUTES=30

# JPEG/RAW with the same base name must be captured within this many seconds.
PAIR_WINDOW_SECONDS=2
BURST_MAX_GAP_SECONDS=1.0
INGEST_SESSION_GAP_MINUTES=20
CAMERA_ONLINE_MINUTES=5

# ---- Renditions ----------------------------------------------------------------
PREVIEW_MAX_EDGE=2560
PREVIEW_QUALITY=85
THUMBNAIL_SIZES=256,512,1024
THUMBNAIL_QUALITY=80

# ---- AI ------------------------------------------------------------------------
# local  : built-in heuristic critique, no network (default)
# openai : OpenAI vision model (needs OPENAI_API_KEY)
# ollama : local vision model served by Ollama (e.g. qwen2.5vl, llava)
# none   : technical analysis only
AI_PROVIDER=local
# Run the configured AI provider automatically on every new photo.
AI_AUTO_ANALYZE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=http://192.168.0.142:11434
OLLAMA_MODEL=qwen2.5vl:7b
AI_TIMEOUT_SECONDS=120

# ---- Immich (optional, read-only by default) ----------------------------------
IMMICH_ENABLED=false
# URL the backend uses to reach Immich (container network or LAN)
IMMICH_URL=
# URL your browser uses to open Immich (often the same as IMMICH_URL)
IMMICH_PUBLIC_URL=
IMMICH_API_KEY=

# ---- Security ------------------------------------------------------------------
# Optional shared bearer token for /api/v1. Leave blank on a trusted LAN.
# When set, the frontend proxy injects it automatically.
API_TOKEN=
# Comma-separated origins allowed to call the backend directly from a browser.
CORS_ORIGINS=http://localhost:8765

# ---- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
